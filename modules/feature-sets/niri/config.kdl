
layout {
    gaps 8

    border {
        width 0.5
        active-color "#89b4fa"
        inactive-color "#45475a"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=4
        color "#00000070"
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.92
}

